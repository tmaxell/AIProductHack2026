# Скопировать в .env и при необходимости поменять. Файл .env не коммитится.

# Порт, на котором веб-приложение доступно на хосте
FRONTEND_PORT=8080

# Порт бекенда, пробрасывается на хост только в режиме разработки
BACKEND_PORT=8000

# production | development | test
APP_ENV=production

# fatal | error | warn | info | debug | trace
APP_LOG_LEVEL=info

# Открывать ли /docs со Swagger UI. В production по умолчанию выключено.
APP_EXPOSE_DOCS=false

# Локальный путь используется вне Docker; Compose всегда пишет в named volume.
APP_STORAGE_PATH=./var/change-sets.sqlite
